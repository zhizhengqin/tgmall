# Railway 多阶段构建：前端构建 → Nginx + API 一体化镜像
# ================================================================

# ── Stage 1: 后端 API 构建 ──
FROM node:20-alpine AS api-build
WORKDIR /app
# 安装 OpenSSL（Prisma 查询引擎依赖）
RUN apk add --no-cache openssl libc6-compat
COPY tgmall-api/package*.json ./
RUN npm ci --only=production
COPY tgmall-api/prisma/ prisma/
RUN npx prisma generate
COPY tgmall-api/src/ src/


# ── Stage 2: Mini App 前端构建 ──
FROM node:20-alpine AS miniapp-build
WORKDIR /app
COPY tgmall-miniapp/package*.json ./
RUN npm ci --no-audit --no-fund
COPY tgmall-miniapp/ ./
# 生产构建时将 API 请求指向同域名的 /api/ 路径
ENV VITE_API_URL=
ENV NODE_OPTIONS="--max-old-space-size=1536"
RUN npx vite build --mode production


# ── Stage 3: 运营后台构建 ──
FROM node:20-alpine AS admin-build
WORKDIR /app
COPY tgmall-admin/package*.json ./
RUN npm ci --no-audit --no-fund
COPY tgmall-admin/ ./
ENV NODE_OPTIONS="--max-old-space-size=1536"
RUN npx vite build


# ── Stage 4: Nginx + Node.js 最终镜像 ──
FROM node:20-alpine

# 安装 Nginx + OpenSSL（Prisma 查询引擎依赖）
RUN apk add --no-cache nginx openssl libc6-compat

# 配置 Nginx（配置文件由启动脚本动态生成，覆盖默认配置）
RUN mkdir -p /run/nginx

# 后端 API
COPY --from=api-build /app /app
WORKDIR /app

# 前端静态文件
COPY --from=miniapp-build /app/dist /usr/share/nginx/html/miniapp
COPY --from=admin-build /app/dist /usr/share/nginx/html/admin

# 启动脚本
COPY bin/railway-start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 8080

CMD ["/start.sh"]
