# 环境变量 — tgmall-api
# 复制此文件为 .env 并填入真实值

NODE_ENV=development
PORT=3000

# 数据库 (PostgreSQL 15)
DATABASE_URL=postgresql://tgmall:tgmall_dev@localhost:5432/tgmall

# 缓存 (Redis 7)
REDIS_URL=redis://localhost:6379

# Telegram Bot
BOT_TOKEN=123456:ABC-DEF1234gh...

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# AWS (图片上传 — MVP 阶段可暂不配置，使用本地存储)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=tgmall-images-dev

# 支付 (MVP 阶段使用模拟模式)
BAKONG_API_URL=
ABA_PAY_SECRET=
WING_PAY_SECRET=

# 管理员 Telegram ID（逗号分隔，用于商家审核等管理操作）
ADMIN_TELEGRAM_IDS=123456789

# CDN
CDN_BASE_URL=http://localhost:3000/static
